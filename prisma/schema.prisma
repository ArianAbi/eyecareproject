// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserVerifyType {
  UNVERIFIED
  WAITING_FOR_APPROVAL
  VERIFIED
  REJECTED
}

model User {
  id       String  @id @default(uuid())
  username String  @unique
  number   String  @unique
  password String
  admin    Boolean @default(false)
  credit   Int     @default(0)

  address        String @default("")
  nationalCode   String @default("")
  managementName String @default("")
  storeName      String @default("")

  userStatus UserVerifyType @default(UNVERIFIED)

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  orders              OrderBatch[]
  invoices            Invoice[]
  cart                Cart?
  tickets             Ticket[]
  ticketMessages      TicketMessage[]
  auditLogs           AuditLog[]
  creditTransactions CreditTransaction[]
  discounts           Discount[]
  discountRedemptions DiscountRedemption[]
  blogPosts           BlogPost[]
  blogImages          BlogImageAsset[]
}

enum BlogPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model BlogCategory {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  posts     BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model BlogTag {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  posts     BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model BlogPost {
  id                String         @id @default(uuid())
  slug              String         @unique
  title             String
  excerpt           String         @default("")
  content           Json
  status            BlogPostStatus @default(DRAFT)
  publishedAt       DateTime?
  featured          Boolean        @default(false)
  coverImage         String?
  coverAlt           String?
  seoTitle           String?
  metaDescription   String?
  canonicalUrl      String?
  ogTitle           String?
  ogDescription     String?
  ogImage           String?
  noindex           Boolean        @default(false)
  faq               Json?
  authorId          String
  author            User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  categoryId        String?
  category          BlogCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags              BlogTag[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
}

model BlogImageAsset {
  filename  String   @id
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  size      Int
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
}

enum NotificationType {
  ALERT
  WARNING
  SUCCESS
  ERROR
  NOTIFY
}

model Notification {
  id String @id @default(uuid())

  title       String
  description String
  type        NotificationType

  important Boolean @default(false)

  createdAt DateTime @default(now())
}

model MasterCategory {
  id     String  @id @default(uuid())
  name   String
  active Boolean @default(true)

  type ProductType @default(LENS)

  subCategory SubCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubCategory {
  id          String @id @default(uuid())
  name        String
  description String

  color String @default("transparent")

  masterCategoryId String
  masterCategory   MasterCategory @relation(fields: [masterCategoryId], references: [id])

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProductType {
  LENS
  FRAME
  OTHER
}

enum OrderItemStatus {
  PENDING
  APPROVED
  INPROCESS
  FINISHED
  SENT
  ONHOLD
}

model Product {
  id String @id @default(uuid())

  name        String
  description String
  active      Boolean @default(true)

  price Int

  type ProductType

  categoryId  String
  categoryRel SubCategory @relation(fields: [categoryId], references: [id])

  tags Tags[]

  lens Lens?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  includesGuarantee     Boolean @default(false)
  includesBag           Boolean @default(false)
  includesCleaningSpray Boolean @default(false)
  includesCleaningCloth Boolean @default(false)

  orderItem OrderItem[]
  cartItems CartItem[]
  discounts Discount[]
}

model Tags {
  id    String @id @default(uuid())
  name  String
  color String

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lens {
  id String @id @default(uuid())

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id])

  positiveFromSph String
  positivToSph    String

  negativeFromSph String
  negativeToSph   String

  fromCyl String
  toCyl   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  cartItems CartItem[]

  updatedAt DateTime @updatedAt()
  createdAt DateTime @default(now())
}

model CartItem {
  guaranteeClientName String @default("")
  id                  String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  odSph String
  odCyl String
  osSph String
  osCyl String

  odOnly Boolean @default(false)
  odAux  String  @default("0")
  osAux  String  @default("0")

  rawOrCut RawOrCutType

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  @@index([productId])
}

model OrderBatch {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  orderItems OrderItem[]

  orderUpdate OrderUpdate[]

  discountRedemption DiscountRedemption?

  deliveryPrice Int @default(0)

  customerNote String @default("")

  creditCharged    Int       @default(0)
  creditRefundedAt DateTime?

  orederIdentification Int @unique @default(autoincrement())

  status OrderItemStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  @@index([userId])
}

enum RawOrCutType {
  RAW
  CUT
}

model OrderItem {
  productSnapshot     Json?
  guaranteeClientName String  @default("")
  includesGuarantee   Boolean @default(false)
  id                  String  @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  purchasedPrice Int

  cutPrice Int @default(0)

  odSph String
  odCyl String

  osSph String
  osCyl String

  odOnly Boolean @default(false)

  odAux String @default("0")
  osAux String @default("0")

  orderBatchId String
  orderBatch   OrderBatch @relation(fields: [orderBatchId], references: [id])

  rawOrCut RawOrCutType

  orderUpdate OrderUpdate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  @@index([productId])
}

model OrderUpdate {
  id String @id @default(uuid())

  message String?

  adminOnly      Boolean   @default(false)
  readAt         DateTime?
  creditRefunded Int       @default(0)

  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])

  orderBatchId String?
  orderBatch   OrderBatch? @relation(fields: [orderBatchId], references: [id])

  updatedStatus OrderItemStatus

  createdAt DateTime @default(now())

  @@index([orderBatchId, adminOnly, readAt])
}

enum InvoicePaymentType {
  CREDIT
  CASH
}

enum InvoiceStatus {
  PENDING
  WAITING_FOR_APPORVAL
  PAID
  CANCELED
}

model Invoice {
  creditAppliedAt DateTime?
  paymentAttempts PaymentAttempt[]
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  paymentType InvoicePaymentType
  amount      Int

  dueDate DateTime?

  status InvoiceStatus @default(PENDING)

  invoiceNumber     Int       @unique @default(autoincrement())
  zarinpalAuthority String?   @unique
  zarinpalRefId     String?
  paidAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, createdAt])
}

enum TicketStatus {
  OPEN
  CLOSED
}

model Ticket {
  id        String          @id @default(uuid())
  subject   String
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  status    TicketStatus    @default(OPEN)
  messages  TicketMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  fromAdmin Boolean  @default(false)
  message   String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

enum CreditTransactionType {
  INVOICE
  ORDER
  REFUND
  DAILY_FEE
  ADJUSTMENT
  OPENING_BALANCE
}

model CreditTransaction {
  id           String @id @default(uuid())
  userId       String
  user         User @relation(fields: [userId], references: [id], onDelete: Restrict)
  type         CreditTransactionType
  amount       Int
  balanceAfter Int?
  description  String
  referenceId  String?
  actorId      String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt, id])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, createdAt])
}

model TrafficVisit {
  sessionId      String   @id
  source         String
  referrerDomain String?
  utmSource      String?
  createdAt      DateTime @default(now())

  @@index([createdAt, source])
}

model Setting {
  id String @id @default("global")

  siteName String @default("SalimOptic")

  deliveryPrice Int @default(0)
  cutPrice      Int @default(0)

  baleGroupId     String?
  telegramGroupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Shared fixed-window limits; expired windows are removed during subsequent requests.
model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model ImageAsset {
  filename  String   @id
  ownerId   String
  size      Int
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
}

model PaymentAttempt {
  authority String    @id
  invoiceId String
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  status    String    @default("PENDING")
  createdAt DateTime  @default(now())
  checkedAt DateTime?

  @@index([invoiceId, createdAt])
}

enum DiscountAmountType {
  PERCENT
  FLAT
}

model Discount {
  id          String @id @default(uuid())
  title       String
  description String @default("")

  code String @unique

  amountType DiscountAmountType
  // FLAT values are in Toman. PERCENT values use basis points (10000 = 100%).
  value      Int

  maxUses            Int?
  usedCount          Int       @default(0)
  expiresAt          DateTime?
  active             Boolean   @default(true)
  usersRestricted    Boolean   @default(false)
  productsRestricted Boolean   @default(false)

  // Restriction flags decide scope; an empty restricted list allows nobody.
  users       User[]
  products    Product[]
  redemptions DiscountRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model DiscountRedemption {
  id String @id @default(uuid())

  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  orderBatchId String     @unique
  orderBatch   OrderBatch @relation(fields: [orderBatchId], references: [id], onDelete: Restrict)

  amountApplied Int
  code          String
  title         String
  createdAt     DateTime @default(now())

  @@index([discountId, createdAt])
  @@index([userId, createdAt])
}
