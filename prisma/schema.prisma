// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid())
  username String  @unique
  number   String  @unique
  password String
  admin    Boolean @default(false)
  address  String  @default("")
  credit   Int     @default(0)

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  orders    OrderBatch[]
  invoices  Invoice[]
}

model Invoice {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  amount      Int
  invoiceCode String @unique

  createdAt DateTime @default(now())
}

model MasterCategory {
  id     String  @id @default(uuid())
  name   String
  active Boolean @default(true)

  type ProductType @default(LENS)

  subCategory SubCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubCategory {
  id          String @id @default(uuid())
  name        String
  description String

  color String @default("transparent")

  masterCategoryId String
  masterCategory   MasterCategory @relation(fields: [masterCategoryId], references: [id])

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProductType {
  LENS
  FRAME
  OTHER
}

enum OrderItemStatus {
  SUBMITIED
  LOCKED
  INPROCESS
  FINISHED
  SENT
  DELIVERED
  ONHOLD
}

model Product {
  id String @id @default(uuid())

  name        String
  description String
  active      Boolean @default(true)
  price       Int

  type ProductType

  categoryId  String
  categoryRel SubCategory @relation(fields: [categoryId], references: [id])

  tags Tags[]

  lens Lens?

  customFields CustomField[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  orderItem OrderItem[]
}

model Tags {
  id    String @id @default(uuid())
  name  String
  color String

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lens {
  id String @id @default(uuid())

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id])

  positiveFromSph String
  positivToSph    String

  negativeFromSph String
  negativeToSph   String

  fromCyl String
  toCyl   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderBatch {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  orderItems OrderItem[]

  orderUpdate OrderUpdate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}

enum RawOrCutType {
  RAW
  CUT
}

model OrderItem {
  id String @id @default(uuid())

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id])

  orderBatchId String     @unique
  orderBatch   OrderBatch @relation(fields: [orderBatchId], references: [id])

  customerNote String          @default("")
  status       OrderItemStatus @default(SUBMITIED)

  rawOrCut RawOrCutType

  orderUpdate OrderUpdate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}

model OrderUpdate {
  id String @id @default(uuid())

  message String?

  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])

  orderBatchId String?
  orderBatch   OrderBatch? @relation(fields: [orderBatchId], references: [id])

  updatedStatus OrderItemStatus

  createdAt DateTime @default(now())
}

model CustomField {
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id])

  name        String
  description String?
  value       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
